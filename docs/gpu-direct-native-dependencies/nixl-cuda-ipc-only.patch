+TEST(UcxCudaIpcOnlyValidation, AcceptsOnlyExplicitDirectProfile) {
+    gtest::ScopedEnv env_helper;
+    env_helper.addVar("NIXL_UCX_CUDA_IPC_ONLY", "1");
+    for (const auto tls : {"cuda_ipc", "cuda_ipc,posix,self", "sysv,cuda_ipc,self,posix"}) {
+        env_helper.addVar("UCX_TLS", tls);
+        nixl::ucx::config config;
+        EXPECT_NO_THROW(config.validateTlsCudaSupport()) << tls;
+        env_helper.popVar();
+    }
+}
+
+TEST(UcxCudaIpcOnlyValidation, RejectsHostPayloadFallbackAndAmbiguousProfiles) {
+    gtest::ScopedEnv env_helper;
+    env_helper.addVar("NIXL_UCX_CUDA_IPC_ONLY", "1");
+    for (const auto tls : {"", "posix,self", "cuda", "all", "^tcp", "cuda_ipc,tcp",
