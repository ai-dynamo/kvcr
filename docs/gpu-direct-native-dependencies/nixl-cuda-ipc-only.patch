+    if (nixl::config::getValueDefaulted<bool>("NIXL_UCX_CUDA_IPC_ONLY", false)) {
+        // CUDA IPC is itself a GPU memory transport. Permit a deliberately
+        // restricted profile without enabling CUDA copy's host-staging paths.
+        // The initialized context must still prove CUDA support before use.
+        const auto actual_tls = nixl::config::internal::getenvOptional("UCX_TLS");
+        if (!actual_tls || !tlsIsCudaIpcOnly(*actual_tls)) {
+            const std::string error =
+                "NIXL_UCX_CUDA_IPC_ONLY requires explicit UCX_TLS=cuda_ipc "
+                "with only optional posix,sysv,self control transports";
+            NIXL_ERROR << error;
+            throw std::runtime_error(error);
+        }
+        // Bind the validated policy to the actual UCP configuration, including
+        // when a caller prepared the configuration before setting the variable.
+        if (ucp_config_modify(config_.get(), "TLS", actual_tls->c_str()) != UCS_OK) {
+            throw std::runtime_error("Failed to configure CUDA IPC-only UCX transports");
+        }
+        return;
+    }
     if (nixl::hwInfo::instance().numNvidiaGpus == 0 || !tls || tlsEnablesCudaSupport(*tls)) {
         return;
     }
