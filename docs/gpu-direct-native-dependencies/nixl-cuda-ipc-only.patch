     return deny_list ? !has_cuda_support : has_cuda_support;
 }
 
+bool
+tlsIsCudaIpcOnly(std::string_view tls) {
+    constexpr std::array<std::string_view, 4> allowed = {"cuda_ipc", "posix", "sysv", "self"};
+    unsigned seen = 0;
+    size_t begin = 0;
+    while (true) {
+        const auto end = tls.find(',', begin);
+        const auto token = tls.substr(begin, end == std::string_view::npos ? end : end - begin);
+        const auto selected = std::ranges::find(allowed, token);
+        if (selected == allowed.end()) {
+            return false;
+        }
+        const unsigned bit = 1U << (selected - allowed.begin());
+        if ((seen & bit) != 0) {
+            return false;
+        }
+        seen |= bit;
+        if (end == std::string_view::npos) {
+            return (seen & 1) != 0;
+        }
+        begin = end + 1;
+    }
+}
+
 } // namespace
 
