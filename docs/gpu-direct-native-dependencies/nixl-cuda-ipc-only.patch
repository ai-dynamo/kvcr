+TEST(UcxCudaIpcOnlyEndpointMode, OrdinaryDefaultsAndExplicitOptionsArePreserved) {
+    gtest::ScopedEnv env_helper;
+    env_helper.addVar("NIXL_UCX_CUDA_IPC_ONLY", "0");
+    EXPECT_EQ(get_ucx_backend_common_options().at("ucx_error_handling_mode"), "peer");
+    EXPECT_EQ(resolve_ucx_error_handling_mode(nullptr), UCP_ERR_HANDLING_MODE_PEER);
+    nixl_b_params_t explicit_none = {{"ucx_error_handling_mode", "none"}};
+    nixl_b_params_t explicit_peer = {{"ucx_error_handling_mode", "peer"}};
+    EXPECT_EQ(resolve_ucx_error_handling_mode(&explicit_none), UCP_ERR_HANDLING_MODE_NONE);
+    EXPECT_EQ(resolve_ucx_error_handling_mode(&explicit_peer), UCP_ERR_HANDLING_MODE_PEER);
+}
+
+TEST(UcxCudaIpcOnlyEndpointMode, StrictDefaultsAndExplicitNoneUseSamePolicy) {
+    gtest::ScopedEnv env_helper;
+    env_helper.addVar("NIXL_UCX_CUDA_IPC_ONLY", "1");
+    EXPECT_EQ(get_ucx_backend_common_options().at("ucx_error_handling_mode"), "none");
+    EXPECT_EQ(resolve_ucx_error_handling_mode(nullptr), UCP_ERR_HANDLING_MODE_NONE);
+    nixl_b_params_t omitted;
+    nixl_b_params_t explicit_none = {{"ucx_error_handling_mode", "none"}};
