+UCS_TEST_P(test_cuda_ipc_md, strict_fabric_detection_is_explicit_and_bounded)
+{
+#if HAVE_CUDA_FABRIC
+    mem_buffer legacy(4096, UCS_MEMORY_TYPE_CUDA);
+    uct_cuda_ipc_md_t *ipc = ucs_derived_of(md(), uct_cuda_ipc_md_t);
+    if (!ipc->enable_mnnvl || !ipc->fabric_supported) {
+        UCS_TEST_SKIP_R("Actual enabled MNNVL and accessible fabric IPC required");
+    }
+    cuda_vmm_mem_buffer fabric;
+    CUresult status = fabric.alloc(4096, CU_MEM_HANDLE_TYPE_FABRIC);
+    if ((status == CUDA_ERROR_NOT_PERMITTED) || (status == CUDA_ERROR_NOT_SUPPORTED)) {
+        UCS_TEST_SKIP_R("Actual FABRIC allocation/IMEX access unavailable");
+    }
+    ASSERT_EQ(CUDA_SUCCESS, status);
+    uct_md_mem_attr_t attr;
+    attr.field_mask = UCT_MD_MEM_ATTR_FIELD_MEM_TYPE;
+    ASSERT_EQ(0, ipc->gpu_direct_fabric_only);
+    // The existing legacy detector is not broadened by an enabled fabric.
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mem_query(md(), fabric.ptr(), fabric.size(), &attr));
+    ASSERT_UCS_OK(uct_md_mem_query(md(), legacy.ptr(), legacy.size(), &attr));
+    ipc->gpu_direct_fabric_only = 1;
+    ASSERT_UCS_OK(uct_md_mem_query(md(), fabric.ptr(), fabric.size(), &attr));
+    EXPECT_EQ(UCS_MEMORY_TYPE_CUDA, attr.mem_type);
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mem_query(md(), legacy.ptr(), legacy.size(), &attr));
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mem_query(md(), fabric.ptr(), fabric.size() + 1, &attr));
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mem_query(md(), UCS_PTR_BYTE_OFFSET(fabric.ptr(), 17),
+                               fabric.size(), &attr));
+    uct_md_mem_reg_params_t reg_params = {};
+    reg_params.field_mask = UCT_MD_MEM_REG_FIELD_MEM_TYPE;
+    reg_params.mem_type = UCS_MEMORY_TYPE_CUDA;
+    uct_mem_h memh;
+    ASSERT_UCS_OK(uct_md_mem_reg_v2(md(), fabric.ptr(), fabric.size(), &reg_params, &memh));
+    uct_md_mkey_pack_params_t pack_params = {};
+    std::vector<uint8_t> packed(md_attr().rkey_packed_size);
+    ASSERT_UCS_OK(uct_md_mkey_pack_v2(md(), memh, fabric.ptr(), fabric.size(),
+                                     &pack_params, packed.data()));
+    EXPECT_EQ(UCT_CUDA_IPC_KEY_HANDLE_TYPE_VMM,
+              reinterpret_cast<uct_cuda_ipc_rkey_t*>(packed.data())->ph.handle_type);
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mkey_pack_v2(md(), memh, fabric.ptr(), fabric.size() + 1,
+                                   &pack_params, packed.data()));
+    uct_md_mem_dereg_params_t dereg_params = {};
+    dereg_params.field_mask = UCT_MD_MEM_DEREG_FIELD_MEMH;
+    dereg_params.memh = memh;
+    EXPECT_UCS_OK(uct_md_mem_dereg_v2(md(), &dereg_params));
+    ipc->gpu_direct_fabric_only = 0;
+#else
+    UCS_TEST_SKIP_R("Built without CUDA FABRIC support");
+#endif
+}
+
+UCS_TEST_P(test_cuda_ipc_md, mnnvl_enable_policy_is_per_context)
+{
+#if HAVE_CUDA_FABRIC && HAVE_NVML_FABRIC_INFO
+    const uct_cuda_ipc_md_t *fixture = ucs_derived_of(md(), uct_cuda_ipc_md_t);
+    if (!fixture->enable_mnnvl || !fixture->fabric_supported) {
+        UCS_TEST_SKIP_R("Actual enabled MNNVL fabric is required for policy isolation");
+    }
+    // Copy this fixture's configuration so the other MD and test owners retain
+    // their own policy. Exercise NO->YES and YES->NO with real isolated MDs.
+    uct_cuda_ipc_md_config_t config =
+        *reinterpret_cast<const uct_cuda_ipc_md_config_t*>(m_md_config.get());
+    config.gpu_direct_fabric_only = 0;
+    config.enable_mnnvl = UCS_NO;
+    ucs::handle<uct_md_h> disabled_before;
+    UCS_TEST_CREATE_HANDLE(uct_md_h, disabled_before, uct_md_close, uct_md_open,
+                           GetParam().component, GetParam().md_name.c_str(),
+                           &config.super);
+    EXPECT_FALSE(ucs_derived_of(disabled_before.get(),
+                                uct_cuda_ipc_md_t)->enable_mnnvl);
+
+    config.gpu_direct_fabric_only = 1;
+    config.enable_mnnvl = UCS_YES;
+    ucs::handle<uct_md_h> enabled;
+    UCS_TEST_CREATE_HANDLE(uct_md_h, enabled, uct_md_close, uct_md_open,
+                           GetParam().component, GetParam().md_name.c_str(),
+                           &config.super);
+    EXPECT_TRUE(ucs_derived_of(enabled.get(),
+                               uct_cuda_ipc_md_t)->enable_mnnvl);
+    EXPECT_TRUE(ucs_derived_of(enabled.get(),
+                               uct_cuda_ipc_md_t)->gpu_direct_fabric_only);
+
+    config.gpu_direct_fabric_only = 0;
+    config.enable_mnnvl = UCS_NO;
+    ucs::handle<uct_md_h> disabled_after;
+    UCS_TEST_CREATE_HANDLE(uct_md_h, disabled_after, uct_md_close, uct_md_open,
+                           GetParam().component, GetParam().md_name.c_str(),
+                           &config.super);
+    EXPECT_FALSE(ucs_derived_of(disabled_after.get(),
+                                uct_cuda_ipc_md_t)->enable_mnnvl);
+#else
+    UCS_TEST_SKIP_R("Built without CUDA FABRIC/NVML fabric support");
+#endif
+}
+
 _UCT_MD_INSTANTIATE_TEST_CASE(test_cuda_ipc_md, cuda_ipc);
 
 
