+#if defined(HAVE_CUDA) && CUDA_VERSION >= 12040
+namespace {
+struct MnnvlFabricTestAllocation {
+    CUdeviceptr address = 0;
+    CUmemGenericAllocationHandle handle = 0;
+    size_t bytes = 0;
+    bool mapped = false;
+    ~MnnvlFabricTestAllocation() {
+        if (mapped) cuMemUnmap(address, bytes);
+        if (address) cuMemAddressFree(address, bytes);
+        if (handle) cuMemRelease(handle);
+    }
+    CUresult allocate() {
+        CUdevice device;
+        CUresult status = cuCtxGetDevice(&device);
+        if (status != CUDA_SUCCESS) return status;
+        CUmemAllocationProp prop = {};
+        prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+        prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+        prop.location.id = device;
+        prop.requestedHandleTypes = CU_MEM_HANDLE_TYPE_FABRIC;
+        status = cuMemGetAllocationGranularity(&bytes, &prop, CU_MEM_ALLOC_GRANULARITY_MINIMUM);
+        if (status != CUDA_SUCCESS) return status;
+        status = cuMemCreate(&handle, bytes, &prop, 0);
+        if (status != CUDA_SUCCESS) return status;
+        status = cuMemAddressReserve(&address, bytes, 0, 0, 0);
+        if (status != CUDA_SUCCESS) return status;
+        status = cuMemMap(address, bytes, 0, handle, 0);
+        if (status != CUDA_SUCCESS) return status;
+        mapped = true;
+        CUmemAccessDesc access = {};
+        access.location = prop.location;
+        access.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+        return cuMemSetAccess(address, bytes, &access, 1);
+    }
+};
+}
