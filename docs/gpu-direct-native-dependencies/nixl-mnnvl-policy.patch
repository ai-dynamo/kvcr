+TEST(UcxMnnvlOnlyValidation, OrdinaryBackendDefaultsRemainEmptyAndPeer) {
+    gtest::ScopedEnv env;
+    env.addVar("NIXL_UCX_CUDA_IPC_ONLY", "0");
+    const auto defaults = get_ucx_backend_common_options();
+    EXPECT_EQ(defaults.at("gpu_direct_transport"), "");
+    EXPECT_EQ(defaults.at("gpu_direct_ucx_tls"), "");
+    EXPECT_FALSE(resolve_ucx_mnnvl_only(nullptr));
+    EXPECT_EQ(resolve_ucx_error_handling_mode(nullptr), UCP_ERR_HANDLING_MODE_PEER);
+}
+
+TEST(UcxMnnvlOnlyValidation, AcceptsOnlyExplicitClosedPerBackendProfile) {
+    gtest::ScopedEnv env;
+    env.addVar("NIXL_UCX_CUDA_IPC_ONLY", "0");
+    nixl_b_params_t params = {{"gpu_direct_transport", "mnnvl"},
+                             {"gpu_direct_ucx_tls", "cuda_ipc,tcp,self"}};
+    EXPECT_TRUE(resolve_ucx_mnnvl_only(&params));
+    EXPECT_EQ(resolve_ucx_error_handling_mode(&params), UCP_ERR_HANDLING_MODE_NONE);
+    params["ucx_error_handling_mode"] = "peer";
+    EXPECT_THROW(resolve_ucx_error_handling_mode(&params), std::invalid_argument);
+    params["ucx_error_handling_mode"] = "none";
+    EXPECT_EQ(resolve_ucx_error_handling_mode(&params), UCP_ERR_HANDLING_MODE_NONE);
+}
+
+TEST(UcxMnnvlOnlyValidation, RejectsAliasesStagingNetworkDataAndMissingBindings) {
+    gtest::ScopedEnv env;
+    env.addVar("NIXL_UCX_CUDA_IPC_ONLY", "0");
+    for (const auto tls : {"", "cuda_ipc,tcp", "tcp,cuda_ipc,self", "cuda,tcp,self",
+                           "cuda_ipc,tcp,self,cuda_copy", "cuda_ipc,tcp,self,gdr_copy",
+                           "cuda_ipc,tcp,self,rc", "cuda_ipc,tcp,self,tcp", "all", "^cuda_copy"}) {
+        nixl_b_params_t params = {{"gpu_direct_transport", "mnnvl"},
+                                 {"gpu_direct_ucx_tls", tls}};
+        EXPECT_THROW(resolve_ucx_mnnvl_only(&params), std::invalid_argument) << tls;
+    }
+    nixl_b_params_t orphan = {{"gpu_direct_ucx_tls", "cuda_ipc,tcp,self"}};
+    EXPECT_THROW(resolve_ucx_mnnvl_only(&orphan), std::invalid_argument);
+    nixl_b_params_t unknown = {{"gpu_direct_transport", "rdma"},
+                              {"gpu_direct_ucx_tls", "cuda_ipc,tcp,self"}};
+    EXPECT_THROW(resolve_ucx_mnnvl_only(&unknown), std::invalid_argument);
+}
