+    auto mode = (ipc_only || mnnvl_only) ? UCP_ERR_HANDLING_MODE_NONE : UCP_ERR_HANDLING_MODE_PEER;
     if (const auto option = nixl::getBackendParamOptional<std::string>(
             params, std::string(nixl_ucx_err_handling_param_name))) {
         mode = ucx_err_mode_from_string(*option);
     }
-    if (ipc_only && mode != UCP_ERR_HANDLING_MODE_NONE) {
+    if ((ipc_only || mnnvl_only) && mode != UCP_ERR_HANDLING_MODE_NONE) {
         throw std::invalid_argument(
-            "CUDA IPC-only UCX requires ucx_error_handling_mode=none; "
-            "native peer-failure recovery is unsupported");
+            mnnvl_only ? "MNNVL UCX requires ucx_error_handling_mode=none; native peer-failure recovery is unsupported"
+                       : "CUDA IPC-only UCX requires ucx_error_handling_mode=none; native peer-failure recovery is unsupported");
     }
     return mode;
 }
