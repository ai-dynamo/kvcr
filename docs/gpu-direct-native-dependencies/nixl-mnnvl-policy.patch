+[[nodiscard]] bool
+resolve_ucx_mnnvl_only(const nixl_b_params_t *params) {
+    const auto transport = nixl::getBackendParamDefaulted(
+        params, "gpu_direct_transport", std::string());
+    const auto tls = nixl::getBackendParamDefaulted(
+        params, "gpu_direct_ucx_tls", std::string());
+    if (transport.empty()) {
+        if (!tls.empty()) {
+            throw std::invalid_argument("gpu_direct_ucx_tls requires gpu_direct_transport=mnnvl");
+        }
+        return false;
+    }
+    if (transport != "mnnvl" || tls != "cuda_ipc,tcp,self") {
+        throw std::invalid_argument("Unsupported closed MNNVL backend transport profile");
+    }
+    if (nixl::config::getValueDefaulted<bool>("NIXL_UCX_CUDA_IPC_ONLY", false)) {
+        throw std::invalid_argument("MNNVL backend cannot coexist with CUDA IPC-only global policy");
+    }
+    return true;
+}
