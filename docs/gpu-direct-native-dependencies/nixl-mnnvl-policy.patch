 void
+config::configureMnnvlOnly(std::string_view tls) const {
+    if (tls != "cuda_ipc,tcp,self") {
+        throw std::invalid_argument("MNNVL requires gpu_direct_ucx_tls=cuda_ipc,tcp,self");
+    }
+    if (nixl::config::getValueDefaulted<bool>("NIXL_UCX_CUDA_IPC_ONLY", false)) {
+        throw std::invalid_argument("MNNVL backend cannot coexist with CUDA IPC-only global policy");
+    }
+    // TCP carries UCP active-message control only. Disable both its native PUT
+    // capability and UCP software PUT/GET emulation before creating this context.
+    // cuda_ipc is therefore the only selected native CUDA-memory RMA transport.
+    for (const auto &[key, value] : std::array{
+             std::pair{"TLS", "cuda_ipc,tcp,self"},
+             std::pair{"CUDA_IPC_ENABLE_MNNVL", "y"},
+             std::pair{"CUDA_IPC_GPU_DIRECT_FABRIC_ONLY", "y"},
+             std::pair{"PROTO_ENABLE", "y"},
+             std::pair{"PROTO_EMULATION_ENABLE", "n"},
+             std::pair{"TCP_PUT_ENABLE", "n"}}) {
+        if (ucp_config_modify(config_.get(), key, value) != UCS_OK) {
+            throw std::runtime_error(std::string("Unsupported required MNNVL UCX setting: ") + key);
+        }
+    }
+}
