+static ucs_status_t
+uct_cuda_ipc_md_mem_query(uct_md_h md, const void *address, size_t length,
+                         uct_md_mem_attr_v2_t *mem_attr)
+{
+    CUpointer_attribute attributes[] = {
+        CU_POINTER_ATTRIBUTE_MEMORY_TYPE, CU_POINTER_ATTRIBUTE_IS_MANAGED,
+        CU_POINTER_ATTRIBUTE_DEVICE_ORDINAL,
+        CU_POINTER_ATTRIBUTE_IS_LEGACY_CUDA_IPC_CAPABLE
+    };
+    CUmemorytype memory_type = CU_MEMORYTYPE_HOST;
+    unsigned is_managed     = 0;
+    int device_ordinal      = -1;
+    int legacy_capable      = 0;
+    void *values[]          = {&memory_type, &is_managed, &device_ordinal,
+                               &legacy_capable};
+    CUdeviceptr base_address;
+    size_t alloc_length;
+    CUdevice device;
+    int is_ctx_pushed;
+    ucs_sys_device_t sys_dev;
+    ucs_status_t status;
+
+    if (mem_attr->field_mask & (UCT_MD_MEM_ATTR_V2_FIELD_DMABUF_FD |
+                               UCT_MD_MEM_ATTR_V2_FIELD_DMABUF_OFFSET)) {
+        return UCS_ERR_UNSUPPORTED;
+    }
+    if ((address == NULL) || (length == 0)) {
+        return UCS_ERR_INVALID_ADDR;
+    }
+
+    /* This detector only recognizes ordinary device allocations. In
+     * particular, managed and host-backed VMM memory must not become CUDA
+     * merely because it has a CUDA virtual address. No payload is read. */
+    status = UCT_CUDADRV_FUNC(
+            cuPointerGetAttributes(ucs_static_array_size(attributes),
+                                   attributes, values, (CUdeviceptr)address),
+            UCS_LOG_LEVEL_TRACE);
+    if ((status != UCS_OK) || (memory_type != CU_MEMORYTYPE_DEVICE) ||
+        is_managed || (device_ordinal < 0) || !legacy_capable) {
+        return UCS_ERR_INVALID_ADDR;
+    }
+
+    status = uct_cuda_ipc_check_and_push_ctx((CUdeviceptr)address, &device,
+                                             &is_ctx_pushed);
+    if (status != UCS_OK) {
+        return status;
+    }
+    status = UCT_CUDADRV_FUNC_LOG_DEBUG(cuMemGetAddressRange(
+            &base_address, &alloc_length, (CUdeviceptr)address));
+    uct_cuda_ipc_check_and_pop_ctx(is_ctx_pushed);
+    if ((status != UCS_OK) || ((CUdeviceptr)address < base_address) ||
+        (length > alloc_length) ||
+        (((CUdeviceptr)address - base_address) > (alloc_length - length))) {
+        return UCS_ERR_INVALID_ADDR;
+    }
+
+    sys_dev = uct_cuda_get_sys_dev(device);
+    if (mem_attr->field_mask & UCT_MD_MEM_ATTR_V2_FIELD_MEM_TYPE) {
+        mem_attr->mem_type = UCS_MEMORY_TYPE_CUDA;
+    }
+    if (mem_attr->field_mask & UCT_MD_MEM_ATTR_V2_FIELD_SYS_DEV) {
+        mem_attr->sys_dev = sys_dev;
+    }
+    if (mem_attr->field_mask & UCT_MD_MEM_ATTR_V2_FIELD_BASE_ADDRESS) {
+        mem_attr->base_address = (void*)base_address;
+    }
+    if (mem_attr->field_mask & UCT_MD_MEM_ATTR_V2_FIELD_ALLOC_LENGTH) {
+        mem_attr->alloc_length = alloc_length;
+    }
+    if (mem_attr->field_mask & UCT_MD_MEM_ATTR_V2_FIELD_MEM_FLAGS) {
+        mem_attr->mem_flags = UCS_MEM_FLAG_REGISTRABLE;
+    }
+    ucs_memtype_cache_update((void*)base_address, alloc_length,
+                             UCS_MEMORY_TYPE_CUDA, sys_dev,
+                             UCS_MEM_FLAG_REGISTRABLE);
+    return UCS_OK;
+}
+
+static ucs_status_t
+uct_cuda_ipc_md_detect_memory_type(uct_md_h md, const void *address,
+                                   size_t length,
+                                   ucs_memory_type_t *mem_type_p)
+{
+    uct_md_mem_attr_v2_t attr;
+    ucs_status_t status;
+
+    attr.field_mask = UCT_MD_MEM_ATTR_V2_FIELD_MEM_TYPE;
+    status         = uct_cuda_ipc_md_mem_query(md, address, length, &attr);
+    if (status == UCS_OK) {
+        *mem_type_p = attr.mem_type;
+    }
+    return status;
+}
