+UCS_TEST_P(test_cuda_ipc_md, device_pointer_detection)
+{
+    mem_buffer buffer(4096, UCS_MEMORY_TYPE_CUDA);
+    uct_md_mem_attr_t attr;
+    attr.field_mask = UCT_MD_MEM_ATTR_FIELD_MEM_TYPE |
+                      UCT_MD_MEM_ATTR_FIELD_BASE_ADDRESS |
+                      UCT_MD_MEM_ATTR_FIELD_ALLOC_LENGTH;
+    void *address = UCS_PTR_BYTE_OFFSET(buffer.ptr(), 17);
+
+    EXPECT_TRUE(md_attr().detect_mem_types & UCS_BIT(UCS_MEMORY_TYPE_CUDA));
+    ASSERT_UCS_OK(uct_md_mem_query(md(), address, 100, &attr));
+    EXPECT_EQ(UCS_MEMORY_TYPE_CUDA, attr.mem_type);
+    EXPECT_EQ(buffer.ptr(), attr.base_address);
+    EXPECT_GE(attr.alloc_length, buffer.size());
+    ASSERT_UCS_OK(uct_md_mem_query(md(), attr.base_address, attr.alloc_length,
+                                  &attr));
+
+    ucs_memory_type_t detected = UCS_MEMORY_TYPE_UNKNOWN;
+    ASSERT_UCS_OK(uct_md_detect_memory_type(md(), address, 100, &detected));
+    EXPECT_EQ(UCS_MEMORY_TYPE_CUDA, detected);
+}
+
+UCS_TEST_P(test_cuda_ipc_md, reject_non_device_pointer_detection)
+{
+    mem_buffer host(4096, UCS_MEMORY_TYPE_HOST);
+    uct_md_mem_attr_t attr;
+    attr.field_mask = UCT_MD_MEM_ATTR_FIELD_MEM_TYPE;
+
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mem_query(md(), host.ptr(), host.size(), &attr));
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mem_query(md(), reinterpret_cast<void*>(1), 1, &attr));
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mem_query(md(), NULL, 1, &attr));
+}
+
+UCS_TEST_P(test_cuda_ipc_md, reject_outside_allocation_detection)
+{
+    mem_buffer device(4096, UCS_MEMORY_TYPE_CUDA);
+    uct_md_mem_attr_t attr;
+    attr.field_mask = UCT_MD_MEM_ATTR_FIELD_MEM_TYPE |
+                      UCT_MD_MEM_ATTR_FIELD_BASE_ADDRESS |
+                      UCT_MD_MEM_ATTR_FIELD_ALLOC_LENGTH;
+    ASSERT_UCS_OK(uct_md_mem_query(md(), device.ptr(), 1, &attr));
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mem_query(md(), attr.base_address, attr.alloc_length + 1,
+                               &attr));
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mem_query(md(), device.ptr(),
+                               std::numeric_limits<size_t>::max(), &attr));
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mem_query(md(), UCS_PTR_BYTE_OFFSET(device.ptr(), 17),
+                               attr.alloc_length, &attr));
+    EXPECT_EQ(UCS_ERR_INVALID_ADDR,
+              uct_md_mem_query(md(), device.ptr(), 0, &attr));
+}
+
+UCS_TEST_P(test_cuda_ipc_md, reject_managed_pointer_detection)
+{
+    mem_buffer managed(4096, UCS_MEMORY_TYPE_CUDA_MANAGED);
+    uct_md_mem_attr_t attr;
+    attr.field_mask = UCT_MD_MEM_ATTR_FIELD_MEM_TYPE;
