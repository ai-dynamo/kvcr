+#if defined(HAVE_CUDA) && CUDA_VERSION >= 12040
+namespace {
+struct MnnvlFabricTestAllocation {
+    CUdeviceptr address = 0;
+    CUmemGenericAllocationHandle handle = 0;
+    size_t bytes = 0;
+    bool mapped = false;
+    ~MnnvlFabricTestAllocation() {
+        if (mapped) cuMemUnmap(address, bytes);
+        if (address) cuMemAddressFree(address, bytes);
+        if (handle) cuMemRelease(handle);
+    }
+    CUresult allocate() {
+        CUdevice device;
+        CUresult status = cuCtxGetDevice(&device);
+        if (status != CUDA_SUCCESS) return status;
+        CUmemAllocationProp prop = {};
+        prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+        prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+        prop.location.id = device;
+        prop.requestedHandleTypes = CU_MEM_HANDLE_TYPE_FABRIC;
+        status = cuMemGetAllocationGranularity(&bytes, &prop, CU_MEM_ALLOC_GRANULARITY_MINIMUM);
+        if (status != CUDA_SUCCESS) return status;
+        status = cuMemCreate(&handle, bytes, &prop, 0);
+        if (status != CUDA_SUCCESS) return status;
+        status = cuMemAddressReserve(&address, bytes, 0, 0, 0);
+        if (status != CUDA_SUCCESS) return status;
+        status = cuMemMap(address, bytes, 0, handle, 0);
+        if (status != CUDA_SUCCESS) return status;
+        mapped = true;
+        CUmemAccessDesc access = {};
+        access.location = prop.location;
+        access.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+        return cuMemSetAccess(address, bytes, &access, 1);
+    }
+};
+}
+
+TEST(UcxMnnvlOnlyRegistration, RealFabricVmmInteriorExtentAndLegacyNegative) {
+    int count = 0;
+    if (cudaGetDeviceCount(&count) != cudaSuccess || count == 0) {
+        GTEST_SKIP() << "Actual CUDA GPU required";
+    }
+    ASSERT_EQ(cudaSetDevice(0), cudaSuccess);
+    ASSERT_EQ(cudaFree(nullptr), cudaSuccess);
+    MnnvlFabricTestAllocation allocation;
+    const auto status = allocation.allocate();
+    if (status == CUDA_ERROR_NOT_SUPPORTED || status == CUDA_ERROR_NOT_PERMITTED) {
+        GTEST_SKIP() << "Actual FABRIC allocation/IMEX permission unavailable";
+    }
+    ASSERT_EQ(status, CUDA_SUCCESS);
+    CUdeviceptr observed_base = 0;
+    size_t observed_extent = 0;
+    unsigned mapped = 0;
+    CUpointer_attribute attrs[] = {CU_POINTER_ATTRIBUTE_MAPPING_BASE_ADDR,
+        CU_POINTER_ATTRIBUTE_MAPPING_SIZE, CU_POINTER_ATTRIBUTE_MAPPED};
+    void *values[] = {&observed_base, &observed_extent, &mapped};
+    ASSERT_EQ(cuPointerGetAttributes(3, attrs, values, allocation.address), CUDA_SUCCESS);
+    EXPECT_TRUE(mapped);
+    EXPECT_EQ(observed_base, allocation.address);
+    EXPECT_EQ(observed_extent, allocation.bytes);
+    EXPECT_TRUE(validate_mnnvl_fabric_range(reinterpret_cast<void *>(allocation.address), allocation.bytes));
+    EXPECT_TRUE(validate_mnnvl_fabric_range(reinterpret_cast<void *>(allocation.address + 17), 100));
+    EXPECT_FALSE(validate_mnnvl_fabric_range(reinterpret_cast<void *>(allocation.address + 17), allocation.bytes));
+    EXPECT_FALSE(validate_mnnvl_fabric_range(reinterpret_cast<void *>(allocation.address), allocation.bytes + 1));
+    void *legacy = nullptr;
+    ASSERT_EQ(cudaMalloc(&legacy, 4096), cudaSuccess);
+    EXPECT_FALSE(validate_mnnvl_fabric_range(legacy, 4096));
+    EXPECT_EQ(cudaFree(legacy), cudaSuccess);
+    void *managed = nullptr;
+    ASSERT_EQ(cudaMallocManaged(&managed, 4096), cudaSuccess);
+    EXPECT_FALSE(validate_mnnvl_fabric_range(managed, 4096));
+    EXPECT_EQ(cudaFree(managed), cudaSuccess);
+}
+#endif
