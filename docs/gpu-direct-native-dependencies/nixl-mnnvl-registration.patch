+bool
+validate_mnnvl_fabric_range(const void *address, size_t length) {
+#if defined(NIXL_UCX_HAVE_CUDA) && CUDA_VERSION >= 12040
+    if (address == nullptr || length == 0) {
+        return false;
+    }
+    CUmemorytype memory_type = CU_MEMORYTYPE_HOST;
+    unsigned managed = 0;
+    int ordinal = -1;
+    unsigned long long allowed_handles = 0;
+    int legacy_capable = 0;
+    CUpointer_attribute attributes[] = {CU_POINTER_ATTRIBUTE_MEMORY_TYPE,
+        CU_POINTER_ATTRIBUTE_IS_MANAGED, CU_POINTER_ATTRIBUTE_DEVICE_ORDINAL,
+        CU_POINTER_ATTRIBUTE_ALLOWED_HANDLE_TYPES, CU_POINTER_ATTRIBUTE_IS_LEGACY_CUDA_IPC_CAPABLE};
+    void *values[] = {&memory_type, &managed, &ordinal, &allowed_handles, &legacy_capable};
+    const auto pointer = reinterpret_cast<CUdeviceptr>(address);
+    if (length - 1 > std::numeric_limits<CUdeviceptr>::max() - pointer) {
+        return false;
+    }
+    if (cuPointerGetAttributes(5, attributes, values, pointer) != CUDA_SUCCESS ||
+        memory_type != CU_MEMORYTYPE_DEVICE || managed || ordinal < 0 || legacy_capable ||
+        !(allowed_handles & CU_MEM_HANDLE_TYPE_FABRIC)) {
+        return false;
+    }
+    CUdevice device;
+    int fabric_supported = 0;
+    if (cuDeviceGet(&device, ordinal) != CUDA_SUCCESS ||
+        cuDeviceGetAttribute(&fabric_supported,
+            CU_DEVICE_ATTRIBUTE_HANDLE_TYPE_FABRIC_SUPPORTED, device) != CUDA_SUCCESS ||
+        !fabric_supported) {
+        return false;
+    }
+    CUcontext primary;
+    if (cuDevicePrimaryCtxRetain(&primary, device) != CUDA_SUCCESS) {
+        return false;
+    }
+    if (cuCtxPushCurrent(primary) != CUDA_SUCCESS) {
+        cuDevicePrimaryCtxRelease(device);
+        return false;
+    }
+    const bool valid = [&]() {
+        CUdeviceptr base = 0;
+        size_t extent = 0;
+        unsigned mapped = 0;
+        CUpointer_attribute range_attributes[] = {CU_POINTER_ATTRIBUTE_MAPPING_BASE_ADDR,
+            CU_POINTER_ATTRIBUTE_MAPPING_SIZE, CU_POINTER_ATTRIBUTE_MAPPED};
+        void *range_values[] = {&base, &extent, &mapped};
+        if (cuPointerGetAttributes(3, range_attributes, range_values, pointer) != CUDA_SUCCESS ||
+            !mapped || pointer < base || length > extent || pointer - base > extent - length) {
+            return false;
+        }
+        // A reservation can span multiple mappings. Require both endpoints to
+        // resolve to the same retained physical VMM handle before accepting it.
+        CUmemGenericAllocationHandle first = 0, last = 0;
+        if (cuMemRetainAllocationHandle(&first, const_cast<void *>(address)) != CUDA_SUCCESS) {
+            return false;
+        }
+        if (cuMemRetainAllocationHandle(&last, reinterpret_cast<void *>(pointer + length - 1)) != CUDA_SUCCESS) {
+            cuMemRelease(first);
+            return false;
+        }
+        CUmemAllocationProp properties = {};
+        CUmemFabricHandle exported = {};
+        const bool physical = first == last &&
+            cuMemGetAllocationPropertiesFromHandle(&properties, first) == CUDA_SUCCESS &&
+            properties.type == CU_MEM_ALLOCATION_TYPE_PINNED &&
+            properties.location.type == CU_MEM_LOCATION_TYPE_DEVICE &&
+            (properties.requestedHandleTypes & CU_MEM_HANDLE_TYPE_FABRIC) &&
+            cuMemExportToShareableHandle(&exported, first, CU_MEM_HANDLE_TYPE_FABRIC, 0) == CUDA_SUCCESS;
+        const auto release_last = cuMemRelease(last);
+        const auto release_first = cuMemRelease(first);
+        return physical && release_last == CUDA_SUCCESS && release_first == CUDA_SUCCESS;
+    }();
+    CUcontext popped = nullptr;
+    const auto pop_status = cuCtxPopCurrent(&popped);
+    const auto release_status = cuDevicePrimaryCtxRelease(device);
+    return valid && pop_status == CUDA_SUCCESS && popped == primary && release_status == CUDA_SUCCESS;
+#else
+    // A CPU-only or pre-FABRIC build must never accept a claimed MNNVL buffer.
+    return false;
+#endif
+}
